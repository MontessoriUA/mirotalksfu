{
    "_readme": "Montemeet room profile registry. Copy to montemeet-profiles.json and edit. 'rooms' maps a room name to a profile name; '*' is the fallback. audio:null means stock MiroTalk behavior. devicePriority.match: device-label substring selected as default camera/mic when present (e.g. SplitCam on school computers). presenters: room -> teacher NAME (deterministic presenter, joining order does not matter).",
    "devicePriority": {
        "match": "splitcam"
    },
    "profiles": {
        "music": {
            "audio": {
                "echoCancellation": true,
                "autoGainControl": false,
                "noiseSuppression": false,
                "opusDtx": false,
                "opusMaxAverageBitrate": 128000
            }
        },
        "anchored-lesson": {
            "audio": {
                "echoCancellation": true,
                "autoGainControl": false,
                "noiseSuppression": false,
                "opusDtx": false,
                "opusMaxAverageBitrate": 128000
            },
            "layout": {
                "anchor": "presenter"
            },
            "roles": "lesson"
        },
        "anchored-group": {
            "audio": null,
            "layout": {
                "mode": "anchored",
                "anchor": "presenter",
                "view": "pin",
                "holdMs": 1500,
                "silenceMs": 4000,
                "minVolume": 3
            },
            "roles": "lesson"
        },
        "concert": {
            "audio": {
                "echoCancellation": true,
                "autoGainControl": false,
                "noiseSuppression": false,
                "opusDtx": false,
                "opusMaxAverageBitrate": 128000
            },
            "layout": {
                "mode": "concert",
                "anchor": "presenter",
                "holdMs": 1500,
                "silenceMs": 4000,
                "minVolume": 2,
                "view": "pin",
                "splash": ""
            },
            "roles": "concert"
        },
        "default": {
            "audio": null
        },
        "dance": {
            "audio": null,
            "layout": {
                "mode": "anchored",
                "anchor": "presenter",
                "view": "pin",
                "holdMs": 1500,
                "silenceMs": 4000,
                "minVolume": 3
            },
            "roles": "lesson"
        }
    },
    "rooms": {
        "*": "default"
    },
    "presenters": {},
    "googleClientId": ""
}
