{
    "_readme": "Montemeet room profile registry. Copy to montemeet-profiles.json and edit. 'rooms' maps a room name to a profile name; '*' is the fallback. audio:null means stock MiroTalk behavior. devicePriority.match: device-label substring selected as default camera/mic when present (e.g. SplitCam on school computers).",
    "devicePriority": { "match": "splitcam" },
    "profiles": {
        "music": {
            "audio": {
                "echoCancellation": true,
                "autoGainControl": false,
                "noiseSuppression": false,
                "opusDtx": false,
                "opusMaxAverageBitrate": 128000
            }
        },
        "anchored-lesson": {
            "audio": {
                "echoCancellation": true,
                "autoGainControl": false,
                "noiseSuppression": false,
                "opusDtx": false,
                "opusMaxAverageBitrate": 128000
            },
            "layout": { "anchor": "presenter" }
        },
        "anchored-group": {
            "audio": null,
            "layout": {
                "mode": "anchored",
                "anchor": "presenter",
                "view": "pin"
            }
        },
        "concert": {
            "audio": {
                "echoCancellation": true,
                "autoGainControl": false,
                "noiseSuppression": false,
                "opusDtx": false,
                "opusMaxAverageBitrate": 128000
            },
            "layout": {
                "mode": "concert",
                "anchor": "presenter",
                "holdMs": 1500,
                "silenceMs": 4000,
                "minVolume": 2
            }
        },
        "default": {
            "audio": null
        }
    },
    "rooms": {
        "*": "default"
    }
}
